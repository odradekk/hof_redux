{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hof-redux.local/schema/s1-common.schema.json",
  "title": "S1 内容公共形状",
  "definitions": {
    "sourceRef": {
      "type": "object",
      "required": ["file", "lines", "note"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "lines": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sourceRef" }
    },
    "tacticsCondition": {
      "type": "object",
      "required": ["conditionId", "quantity"],
      "properties": {
        "conditionId": { "type": "string", "pattern": "^condition\\." },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 99999 }
      },
      "additionalProperties": false
    },
    "tacticsGroup": {
      "type": "object",
      "required": ["conditions", "skillId"],
      "properties": {
        "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/tacticsCondition" } },
        "skillId": { "type": "string", "pattern": "^skill\\.", "not": { "const": "skill.9000" } }
      },
      "additionalProperties": false
    },
    "guardPolicy": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["always", "never", "hp-rate-gte", "probability"] },
        "threshold": { "enum": [25, 50, 75] }
      },
      "additionalProperties": false
    },
    "baseStats": {
      "type": "object",
      "required": ["str", "int", "dex", "spd", "luk"],
      "properties": {
        "str": { "type": "integer", "minimum": 0 },
        "int": { "type": "integer", "minimum": 0 },
        "dex": { "type": "integer", "minimum": 0 },
        "spd": { "type": "integer", "minimum": 0 },
        "luk": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
