{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hof-redux.local/schema/s1-content.schema.json",
  "title": "S1 首批内容包编辑源结构",
  "description": "构建与发布检查用 ajv 实际执行本文件的单文件结构规则；跨文件引用、处理器登记、数值分布语义与素材完整性由 packages/content 语义检查执行。",
  "definitions": {
    "recruitmentFile": {
      "type": "object",
      "required": ["recruitments"],
      "properties": {
        "recruitments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "oldNo",
              "presentation",
              "jobId",
              "price",
              "initialLevel",
              "initialExperience",
              "initialStats",
              "initialHpSp",
              "initialSkillIds",
              "initialEquipment",
              "position",
              "guardPolicy",
              "defaultTactics",
              "sources"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^recruit\\." },
              "oldNo": { "type": "string", "minLength": 1 },
              "presentation": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "minLength": 1 } },
                "additionalProperties": false
              },
              "jobId": { "type": "string", "pattern": "^job\\." },
              "price": { "type": "integer", "minimum": 1 },
              "initialLevel": { "type": "integer", "minimum": 1, "maximum": 50 },
              "initialExperience": { "type": "integer", "minimum": 0 },
              "initialStats": { "$ref": "s1-common.schema.json#/definitions/baseStats" },
              "initialHpSp": {
                "type": "object",
                "required": ["maxHp", "hp", "maxSp", "sp"],
                "properties": {
                  "maxHp": { "type": "integer", "minimum": 1 },
                  "hp": { "type": "integer", "minimum": 1 },
                  "maxSp": { "type": "integer", "minimum": 1 },
                  "sp": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              },
              "initialSkillIds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^skill\\.", "not": { "const": "skill.9000" } }
              },
              "initialEquipment": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "weapon": { "type": "string", "pattern": "^item\\." },
                  "shield": { "type": "string", "pattern": "^item\\." },
                  "armor": { "type": "string", "pattern": "^item\\." }
                },
                "additionalProperties": false
              },
              "position": { "enum": ["front", "back"] },
              "guardPolicy": { "$ref": "s1-common.schema.json#/definitions/guardPolicy" },
              "defaultTactics": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "s1-common.schema.json#/definitions/tacticsGroup" }
              },
              "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "jobsFile": {
      "type": "object",
      "required": ["jobs"],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "oldNo", "presentation", "hpSpCoefficients", "allowedEquipmentTypes", "sources"],
            "properties": {
              "id": { "type": "string", "pattern": "^job\\." },
              "oldNo": { "type": "string", "minLength": 1 },
              "presentation": {
                "type": "object",
                "required": ["nameMale", "nameFemale", "imageMaleAssetId", "imageFemaleAssetId"],
                "properties": {
                  "nameMale": { "type": "string", "minLength": 1 },
                  "nameFemale": { "type": "string", "minLength": 1 },
                  "imageMaleAssetId": { "type": "string", "pattern": "^asset\\." },
                  "imageFemaleAssetId": { "type": "string", "pattern": "^asset\\." }
                },
                "additionalProperties": false
              },
              "hpSpCoefficients": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "exclusiveMinimum": 0 }
              },
              "allowedEquipmentTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "itemsFile": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "title": "equipment",
                "type": "object",
                "required": [
                  "id",
                  "oldNo",
                  "kind",
                  "name",
                  "equipmentType",
                  "slot",
                  "handleCost",
                  "buyPrice",
                  "imageAssetId",
                  "instancePolicy",
                  "twoHanded",
                  "sources"
                ],
                "properties": {
                  "id": { "type": "string", "pattern": "^item\\." },
                  "oldNo": { "type": "string", "minLength": 1 },
                  "kind": { "const": "equipment" },
                  "name": { "type": "string", "minLength": 1 },
                  "equipmentType": { "type": "string", "minLength": 1 },
                  "slot": { "enum": ["weapon", "shield", "armor"] },
                  "blockedSlots": { "type": "array", "items": { "type": "string" } },
                  "atk": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
                  "def": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } },
                  "handleCost": { "type": "integer", "minimum": 0 },
                  "twoHanded": { "type": "boolean" },
                  "buyPrice": { "type": "integer", "minimum": 0 },
                  "imageAssetId": { "type": "string", "pattern": "^asset\\." },
                  "instancePolicy": { "const": "independent" },
                  "futureCraftNeedsOld": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["oldNo", "quantity"],
                      "properties": {
                        "oldNo": { "type": "string", "minLength": 1 },
                        "quantity": { "type": "integer", "minimum": 1 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
                },
                "additionalProperties": false
              },
              {
                "title": "material",
                "type": "object",
                "required": ["id", "oldNo", "kind", "name", "buyPrice", "imageAssetId", "stackable", "sources"],
                "properties": {
                  "id": { "type": "string", "pattern": "^item\\." },
                  "oldNo": { "type": "string", "minLength": 1 },
                  "kind": { "const": "material" },
                  "name": { "type": "string", "minLength": 1 },
                  "buyPrice": { "type": "integer", "minimum": 0 },
                  "sellPrice": { "type": "integer", "minimum": 0 },
                  "imageAssetId": { "type": "string", "pattern": "^asset\\." },
                  "stackable": { "const": true },
                  "futureUse": { "type": "string" },
                  "futureAffix": { "type": "string" },
                  "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "skillsFile": {
      "type": "object",
      "required": ["skills"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "title": "generic-damage",
                "type": "object",
                "required": [
                  "id",
                  "oldNo",
                  "name",
                  "imageAssetId",
                  "spCost",
                  "damageType",
                  "target",
                  "power",
                  "preDelay",
                  "postDelay",
                  "sources"
                ],
                "properties": {
                  "id": { "type": "string", "pattern": "^skill\\.", "not": { "const": "skill.9000" } },
                  "oldNo": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "imageAssetId": { "type": "string", "pattern": "^asset\\." },
                  "spCost": { "type": "integer", "minimum": 0, "maximum": 99999 },
                  "damageType": { "enum": ["physical", "magic"] },
                  "target": {
                    "type": "object",
                    "required": ["side", "mode", "hits"],
                    "properties": {
                      "side": { "enum": ["enemy", "self", "friend", "all"] },
                      "mode": { "enum": ["single", "random-multi", "all"] },
                      "hits": { "type": "integer", "minimum": 1, "maximum": 8 }
                    },
                    "additionalProperties": false
                  },
                  "power": { "type": "integer", "minimum": 1, "maximum": 10000 },
                  "preDelay": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "postDelay": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "ignoreGuard": { "type": "boolean" },
                  "support": { "type": "boolean" },
                  "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
                },
                "additionalProperties": false
              },
              {
                "title": "named-handler",
                "type": "object",
                "required": [
                  "id",
                  "oldNo",
                  "name",
                  "imageAssetId",
                  "spCost",
                  "damageType",
                  "target",
                  "handlerId",
                  "handlerParams",
                  "sources"
                ],
                "properties": {
                  "id": { "type": "string", "pattern": "^skill\\.", "not": { "const": "skill.9000" } },
                  "oldNo": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "imageAssetId": { "type": "string", "pattern": "^asset\\." },
                  "spCost": { "type": "integer", "minimum": 0, "maximum": 99999 },
                  "damageType": { "enum": ["physical", "magic"] },
                  "target": {
                    "type": "object",
                    "required": ["side", "mode", "hits"],
                    "properties": {
                      "side": { "enum": ["enemy", "self", "friend", "all"] },
                      "mode": { "enum": ["single", "random-multi", "all"] },
                      "hits": { "type": "integer", "minimum": 1, "maximum": 8 }
                    },
                    "additionalProperties": false
                  },
                  "ignoreGuard": { "type": "boolean" },
                  "support": { "type": "boolean" },
                  "handlerId": { "type": "string", "minLength": 1 },
                  "handlerParams": { "type": "object" },
                  "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "conditionsFile": {
      "type": "object",
      "required": ["conditions", "connectorNote"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "oldNo", "kind", "quantityRange", "description", "sources"],
            "properties": {
              "id": { "type": "string", "pattern": "^condition\\.", "not": { "const": "condition.9000" } },
              "oldNo": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["always", "self-sp-absolute-gte", "self-sp-absolute-lte", "probability-percent"] },
              "quantityUnit": { "type": "string" },
              "quantityRange": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 0 }
              },
              "description": { "type": "string", "minLength": 1 },
              "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
            },
            "additionalProperties": false
          }
        },
        "connectorNote": {
          "type": "object",
          "required": ["oldNo", "note"],
          "properties": {
            "oldNo": { "const": "9000" },
            "note": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "monstersFile": {
      "type": "object",
      "required": ["monsters"],
      "properties": {
        "monsters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "oldNo",
              "name",
              "level",
              "baseStats",
              "maxHp",
              "maxSp",
              "atk",
              "def",
              "position",
              "guardPolicy",
              "tactics",
              "experienceReward",
              "moneyReward",
              "drops",
              "imageAssetId",
              "sources"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^monster\\." },
              "oldNo": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "level": { "type": "integer", "minimum": 1 },
              "baseStats": { "$ref": "s1-common.schema.json#/definitions/baseStats" },
              "maxHp": { "type": "integer", "minimum": 1 },
              "maxSp": { "type": "integer", "minimum": 1 },
              "atk": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
              "def": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer" } },
              "position": { "enum": ["front", "back", null] },
              "guardPolicy": { "$ref": "s1-common.schema.json#/definitions/guardPolicy" },
              "tactics": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "s1-common.schema.json#/definitions/tacticsGroup" }
              },
              "experienceReward": { "type": "integer", "minimum": 0 },
              "moneyReward": { "type": "integer", "minimum": 0 },
              "drops": {
                "type": "object",
                "required": ["denominator", "entries"],
                "properties": {
                  "denominator": { "const": 10000 },
                  "entries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["itemId", "weight"],
                      "properties": {
                        "itemId": { "type": "string", "pattern": "^item\\." },
                        "weight": { "type": "integer", "minimum": 1 }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "imageAssetId": { "type": "string", "pattern": "^asset\\." },
              "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "mapsFile": {
      "type": "object",
      "required": ["maps"],
      "properties": {
        "maps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "oldId",
              "name",
              "nameEn",
              "background",
              "backgroundAssetId",
              "levelLabel",
              "enemyCount",
              "encounters",
              "sources"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^map\\." },
              "oldId": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "nameEn": { "type": "string", "minLength": 1 },
              "background": { "type": "string", "minLength": 1 },
              "backgroundAssetId": { "type": "string", "pattern": "^asset\\." },
              "levelLabel": { "type": "string", "minLength": 1 },
              "enemyCount": {
                "type": "object",
                "required": ["mode", "min", "max"],
                "properties": {
                  "mode": { "const": "equal-party-size" },
                  "min": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "max": { "type": "integer", "minimum": 1, "maximum": 5 }
                },
                "additionalProperties": false
              },
              "encounters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["monsterId", "weight", "preview"],
                  "properties": {
                    "monsterId": { "type": "string", "pattern": "^monster\\." },
                    "weight": { "type": "integer", "minimum": 0 },
                    "preview": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              },
              "sources": { "$ref": "s1-common.schema.json#/definitions/sources" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "assetsFile": {
      "type": "object",
      "required": ["assets"],
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path", "sourceFile", "sha256", "bytes", "usedBy"],
            "properties": {
              "id": { "type": "string", "pattern": "^asset\\." },
              "path": { "type": "string", "pattern": "^content/assets/" },
              "sourceFile": { "type": "string", "pattern": "^old_hof/image/" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "usedBy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
